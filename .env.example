# NCBI Entrez (required: email; API key strongly recommended)
NCBI_EMAIL=your.name@example.com
NCBI_API_KEY=

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible). Pick ONE provider below.
# ---------------------------------------------------------------------------

# Option A — OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Option B — DeepSeek (recommended if OpenAI has no credits)
DEEPSEEK_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your.name@example.com
# Fallback recipients if playbook.yaml recipients list is empty
EMAIL_TO=recipient1@example.com,recipient2@example.com

# Pipeline defaults (playbook.yaml schedule.lookback_days overrides LOOKBACK_DAYS when present)
LOOKBACK_DAYS=7
IMPORTANCE_THRESHOLD=7
SCHEDULE_MODE=weekly
